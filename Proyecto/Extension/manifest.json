{
  "manifest_version": 3,
  "name": "Autocompletado de Hojas de Vida",
  "version": "1.0",
  "description": "Extensión para autocompletar formularios con datos del usuario.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
